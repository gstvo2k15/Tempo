local.file_match "tomcat" {
  path_targets = [{
    __path__     = "/var/log/tomcat/*.log",
    job          = "tomcat",
    service_name = "tomcat-demo",
  }]
}

loki.source.file "tomcat" {
  targets    = local.file_match.tomcat.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}