        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(target_info{job=~\"$service\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(target_info{job=~\"$service\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
